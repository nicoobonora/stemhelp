{
  "name": "stemhelp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-desktop/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.desktop.json && tsc --noEmit -p tsconfig.json && vite build && node scripts/copy-pdf-assets.mjs",
    "start": "npm run build && node scripts/launch.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "jose": "6.2.12",
    "katex": "^0.19.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.2"
  },
  "description": "A local-first desktop study companion for technical subjects.",
  "author": "stemhelp",
  "build": {
    "appId": "it.study.quadernone",
    "productName": "stemhelp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.education",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
